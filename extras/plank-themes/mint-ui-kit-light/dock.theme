# mint-ui-kit Plank theme (light): solid background to match Orchis.
# Solid colours also look right over remote desktop, where compositing
# (transparency) is often off.
[PlankTheme]
TopRoundness=8
BottomRoundness=0
LineWidth=1
OuterStrokeColor=214;;214;;214;;255
FillStartColor=246;;246;;246;;255
FillEndColor=246;;246;;246;;255
InnerStrokeColor=246;;246;;246;;255

[PlankDockTheme]
HorizPadding=2
TopPadding=1
BottomPadding=1
ItemPadding=4
IndicatorSize=4
IconShadowSize=0
CascadeHide=false
